{
  "name": "opsflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down",
    "db:reset": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v && pnpm db:up",
    "db:psql": "docker compose --env-file .env -f infra/compose/docker-compose.yml exec postgres psql -U postgres -d opsflow",
    "db:migrate": "pnpm --filter @opsflow/db migrate",
    "db:migration:new": "pnpm --filter @opsflow/db migration:new"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
