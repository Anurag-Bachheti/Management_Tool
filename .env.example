# Copy to .env (never committed) and adjust if you like. Local development only.
POSTGRES_PASSWORD=postgres-dev
OPSFLOW_OWNER_PASSWORD=owner-dev
OPSFLOW_APP_PASSWORD=app-dev
OPSFLOW_WORKER_PASSWORD=worker-dev

# Host port for Postgres (default 5432). Set it if 5432 is already taken on this machine.
# POSTGRES_PORT=5434

# Port must match POSTGRES_PORT; password must match OPSFLOW_OWNER_PASSWORD
MIGRATION_DATABASE_URL=postgresql://opsflow_owner:owner-dev@127.0.0.1:5432/opsflow
